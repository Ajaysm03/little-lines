# Copy this file to .env and fill it in. Never commit .env.
# On Vercel, add the same names under Project → Settings → Environment Variables.

# Neon: Dashboard → your project → Connect → copy the connection string (pooled is fine).
# For a database on your Mac with no sign-up, run `npm run db:local` and use:
#   DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
DATABASE_URL=

# Where the app is opened. Locally http://localhost:5173; on Vercel your https:// address.
APP_URL=http://localhost:5173

# A long random string that signs sessions. Make one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in (optional; the Google button only shows when both are set).
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Password-reset emails (optional locally: without a key the reset link is printed in the terminal).
# resend.com → API Keys. EMAIL_FROM must use a domain you verified in Resend
# (onboarding@resend.dev only delivers to your own Resend account email).
RESEND_API_KEY=
EMAIL_FROM=Little Lines <onboarding@resend.dev>

# Test family created by `npm run db:seed`.
SEED_NAME=Test Parent
SEED_EMAIL=parent@example.test
SEED_PASSWORD=snowfall-test-2026
SEED_PARENT_PIN=2468
SEED_CHILD_PIN=1357
