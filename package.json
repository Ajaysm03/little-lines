{
  "name": "little-lines",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "assets": "node scripts/build-assets.mjs",
    "icons": "node scripts/build-icons.mjs",
    "dev:https": "HTTPS=1 vite --host",
    "preview:https": "HTTPS=1 vite preview --host",
    "db:local": "pglite-server --db=.pglite --port=5433 --max-connections=1",
    "db:migrate": "tsx --env-file=.env server/cli/migrate.ts",
    "db:seed": "tsx --env-file=.env server/cli/seed.ts",
    "owner:create": "tsx --env-file=.env server/cli/owner.ts"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/shantell-sans": "^5.3.0",
    "@noble/hashes": "^2.4.0",
    "better-auth": "^1.7.20",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.79.0",
    "page-flip": "^2.0.7",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.6",
    "resend": "^6.39.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@electric-sql/pglite-socket": "^0.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.12",
    "workbox-window": "^7.4.1"
  },
  "engines": {
    "node": ">=22.13"
  }
}
